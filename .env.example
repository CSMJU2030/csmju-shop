# ---------------------------------------------------------------------------
# CSMJU2030 subsystem (csmju-shop) - ตัวอย่าง environment  (ห้าม commit .env)
#
# ไฟล์นี้ใช้กับ docker compose ที่รากของ repo (SHOP_DB_*)
# backend อ่านค่าจาก backend/.env  → คัดลอกจาก backend/.env.example
# frontend อ่านค่าจาก frontend/.env.local → คัดลอกจาก frontend/.env.example
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5028

# ฐานข้อมูลของ subsystem นี้เท่านั้น (shop_db) - ห้ามชี้ไปที่ core_hub
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/shop_db
SHOP_DB_USER=postgres
SHOP_DB_PASSWORD=change_me

# Core Hub (ผู้ให้ identity)
CORE_HUB_URL=http://localhost:3000
CORE_HUB_JWKS_URL=http://localhost:3000/api/v1/.well-known/jwks.json
CORE_HUB_WEB_URL=http://localhost:3100

# สัญญาที่ตรึงไว้ - ห้ามเปลี่ยนค่าเหล่านี้เอง
CORE_HUB_ISSUER=core-hub
CORE_HUB_AUDIENCE=csmju2030

# ตัวตนของ subsystem - ต้องตรงกับ name ใน Subsystem Registry
SUBSYSTEM_ID=csmju-shop

# JWKS cache
JWKS_CACHE_TTL_MS=600000
JWKS_MIN_REFRESH_INTERVAL_MS=30000
JWKS_REQUEST_TIMEOUT_MS=5000
JWT_CLOCK_TOLERANCE_SEC=5
