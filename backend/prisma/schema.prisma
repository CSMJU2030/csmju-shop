// ============================================================
//  CSMJU-Shop : Prisma Schema
//  Database : PostgreSQL  (csmju_shop)
//  ออกแบบตาม ER Diagram : products, product_variants,
//                          orders, order_items, pickup_logs
//
//  ไม่มีตาราง users — ตัวตนผู้ใช้เป็นของ Core Hub (data-dictionary ข้อ 9.2)
//  ระบบนี้อ้างผู้ใช้ด้วย core_user_id และเก็บชื่อ/ติดต่อไว้เป็น snapshot ในคำสั่งซื้อ
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// products : สินค้า (1 สินค้า มีหลาย variant)
// ------------------------------------------------------------
model Product {
  product_id         Int       @id @default(autoincrement())
  name               String    @db.VarChar(150)
  description        String?   @db.Text
  category           String    @db.VarChar(50)
  /// ที่อยู่รูปสินค้า เช่น /uploads/products/xxxx.jpg (ว่างได้ หน้าเว็บจะวาดภาพสำรองให้)
  image_url          String?   @db.VarChar(255)
  is_preorder        Boolean?  @default(false)
  preorder_end_date  DateTime? @db.Timestamptz(6)
  estimated_delivery DateTime? @db.Date
  created_at         DateTime  @default(now()) @db.Timestamptz(6)

  // Relations
  variants ProductVariant[]

  @@index([category])
  @@index([is_preorder])
  @@map("products")
}

// ------------------------------------------------------------
// product_variants : ตัวเลือกสินค้า (ไซส์ / สี) + ราคา + สต็อก
// ------------------------------------------------------------
model ProductVariant {
  variant_id     Int     @id @default(autoincrement())
  product_id     Int
  variant_name   String  @db.VarChar(50)
  price          Decimal @db.Decimal(10, 2)
  stock_quantity Int?    @default(0)

  // Relations
  product     Product     @relation(fields: [product_id], references: [product_id], onDelete: Cascade, onUpdate: Cascade)
  order_items OrderItem[]

  @@unique([product_id, variant_name])
  @@index([product_id])
  @@map("product_variants")
}

// ------------------------------------------------------------
// orders : คำสั่งซื้อ
// ------------------------------------------------------------
model Order {
  order_id         Int      @id @default(autoincrement())
  order_number     String   @unique @db.VarChar(20)
  /// ผู้สั่งซื้อ — claim `sub` จาก Core Hub
  core_user_id     String   @db.VarChar(64)
  /// snapshot ข้อมูลผู้สั่ง ณ เวลาสั่งซื้อ
  customer_name       String  @db.VarChar(100)
  customer_email      String  @db.VarChar(100)
  customer_phone      String  @db.VarChar(15)
  customer_student_id String? @db.VarChar(20)
  total_amount     Decimal  @db.Decimal(10, 2)
  delivery_method  String   @db.VarChar(20)
  shipping_fee     Decimal? @default(0.00) @db.Decimal(10, 2)
  shipping_address String?  @db.Text
  payment_slip     String?  @db.VarChar(255)
  payment_status   String?  @default("pending") @db.VarChar(20)
  order_status     String?  @default("pending") @db.VarChar(20)
  pickup_code      String?  @unique @db.VarChar(50)
  /// ข้อมูลการจัดส่ง — ใช้เฉพาะ delivery_method = "delivery"
  shipping_carrier String?  @db.VarChar(50)
  tracking_number  String?  @db.VarChar(50)
  shipped_at       DateTime? @db.Timestamptz(6)
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  order_items OrderItem[]
  pickup_logs PickupLog[]

  @@index([core_user_id])
  @@index([order_status])
  @@index([payment_status])
  @@index([tracking_number])
  @@map("orders")
}

// ------------------------------------------------------------
// order_items : รายการสินค้าในคำสั่งซื้อ
// ------------------------------------------------------------
model OrderItem {
  item_id          Int      @id @default(autoincrement())
  order_id         Int
  variant_id       Int
  quantity         Int
  unit_price       Decimal  @db.Decimal(10, 2)
  is_preorder_item Boolean? @default(false)

  // Relations
  order   Order          @relation(fields: [order_id], references: [order_id], onDelete: Cascade, onUpdate: Cascade)
  variant ProductVariant @relation(fields: [variant_id], references: [variant_id], onDelete: Restrict, onUpdate: Cascade)

  @@index([order_id])
  @@index([variant_id])
  @@map("order_items")
}

// ------------------------------------------------------------
// pickup_logs : บันทึกการรับสินค้าหน้าร้าน (เจ้าหน้าที่เป็นผู้บันทึก)
// ------------------------------------------------------------
model PickupLog {
  pickup_id   Int      @id @default(autoincrement())
  order_id    Int
  /// เจ้าหน้าที่ผู้บันทึก — claim `sub` จาก Core Hub
  staff_core_user_id String @db.VarChar(64)
  staff_name         String @db.VarChar(100)
  pickup_time DateTime @default(now()) @db.Timestamptz(6)
  notes       String?  @db.Text

  // Relations
  order Order @relation(fields: [order_id], references: [order_id], onDelete: Cascade, onUpdate: Cascade)

  @@index([order_id])
  @@index([staff_core_user_id])
  @@map("pickup_logs")
}
