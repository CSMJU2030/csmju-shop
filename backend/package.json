{
  "name": "backend",
  "version": "1.0.0",
  "description": "CSMJU Shop API - ระบบร้านค้าออนไลน์สาขาวิทยาการคอมพิวเตอร์ ม.แม่โจ้ (NestJS + Prisma + PostgreSQL)",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "seed": "node prisma/seed.cjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "test:api": "newman run postman/CSMJU-Shop.postman_collection.json -e postman/CSMJU-Shop.postman_environment.json",
    "test:smoke": "bash tests/smoke-test.sh"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.4",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.4",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/platform-express": "^12.0.4",
    "@prisma/client": "^6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.5",
    "@nestjs/schematics": "^12.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "type": "module",
  "main": "dist/main.js"
}
