# ---------------------------------------------------------------------------
# CSMJU Shop backend — ตัวอย่าง environment
# คัดลอกเป็น .env แล้วใส่ค่าจริงในเครื่อง (ห้าม commit .env)
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3002

# ฐานข้อมูลของระบบย่อยนี้เท่านั้น (shop_db) - ห้ามชี้ไปที่ core_hub
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/shop_db

# Core Hub (ผู้ให้ identity)
CORE_HUB_URL=http://localhost:3000
CORE_HUB_JWKS_URL=http://localhost:3000/api/v1/.well-known/jwks.json
# เว็บของ Core Hub - GET /auth/login ส่งผู้ใช้ไปที่ {CORE_HUB_WEB_URL}/api/sso/{SUBSYSTEM_ID}
CORE_HUB_WEB_URL=http://localhost:3100

# สัญญาที่ตรึงไว้ - ห้ามเปลี่ยนค่าเหล่านี้เอง
CORE_HUB_ISSUER=core-hub
CORE_HUB_AUDIENCE=csmju2030

# ตัวตนของ subsystem - ต้องตรงกับ name ใน Subsystem Registry และ subsystem.yaml
SUBSYSTEM_ID=csmju-shop

# หน้าเว็บ (Next.js) ที่ callback จะส่งผู้ใช้กลับไปหลังตั้ง session
FRONTEND_URL=http://localhost:4000

# JWKS cache
JWKS_CACHE_TTL_MS=600000
JWKS_MIN_REFRESH_INTERVAL_MS=30000
JWKS_REQUEST_TIMEOUT_MS=5000
JWT_CLOCK_TOLERANCE_SEC=5
