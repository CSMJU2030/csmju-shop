# ---------------------------------------------------------------------------
# CSMJU Shop frontend — ตัวอย่าง environment (ห้าม commit .env / .env.local)
# ค่า NEXT_PUBLIC_* ถูกฝังในหน้าเว็บ = ข้อมูลสาธารณะ ห้ามใส่ความลับ
# ---------------------------------------------------------------------------

# backend (NestJS) — Next.js ส่งต่อ /api/* และ /uploads/* ไปที่นี่
BACKEND_URL=http://localhost:5028

# เว็บ Core Hub — ปุ่มเข้าสู่ระบบพาไปที่ {NEXT_PUBLIC_CORE_HUB_WEB_URL}/api/sso/{NEXT_PUBLIC_SUBSYSTEM_ID}
NEXT_PUBLIC_CORE_HUB_WEB_URL=http://localhost:3100
NEXT_PUBLIC_SUBSYSTEM_ID=csmju-shop
